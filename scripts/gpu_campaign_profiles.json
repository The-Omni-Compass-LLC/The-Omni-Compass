{
  "engine": "omni-v6",
  "launch": false,
  "profiles": {
    "one-card": {
      "physical_gpus": 1,
      "script": "scripts/gpu_rented_run.sh",
      "environment": {
        "HIL_SCALES": "1,10,100,1000",
        "HIL_REPS_BY_SCALE": "5,3,2,1"
      }
    },
    "eight-card": {
      "physical_gpus": 8,
      "script": "scripts/gpu_8card.sh",
      "environment": {
        "POOLED": "1",
        "HIL_SCALES": "1,10,100,1000",
        "HIL_REPS_BY_SCALE": "1,1,1,1"
      }
    }
  },
  "scale_meaning": "Copies of simulated organisms with real GPU hardware in the loop; 1000 is not a measured fleet of 1000 physical GPUs."
}
